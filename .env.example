# Free key from https://www.themoviedb.org/settings/api (v3 API key or v4 read access token)
VITE_TMDB_API_KEY=your_tmdb_v3_api_key
# VidSrc embed domain (backup server; these rotate, swap if one goes down)
VITE_VIDSRC_BASE=https://vidsrc.sh
# Torrentio options: the path segment from torrentio.strem.fun/configure (e.g. add realdebrid=KEY for debrid links)
VITE_TORRENTIO_CONFIG=qualityfilter=scr,cam
# Stremio's local streaming server (runs while the Stremio app is open)
VITE_STREMIO_SERVER=http://127.0.0.1:11470
