# Free key from https://www.themoviedb.org/settings/api (v3 API key or v4 read access token)
VITE_TMDB_API_KEY=your_tmdb_v3_api_key
# VidSrc embed domain (backup server; these rotate, swap if one goes down)
VITE_VIDSRC_BASE=https://vidsrc.sh

# --- Admin dashboard (/admin) ---
# Clerk (dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated Clerk user IDs allowed into /admin (the dashboard shows yours if it's missing)
ADMIN_USER_IDS=user_...
# Neon Postgres connection string (set automatically by the Vercel Marketplace integration)
DATABASE_URL=postgres://...
# Any long random string; Vercel sends it to /api/cron
CRON_SECRET=
# Day boundary for "today" and daily charts. UTC matches Vercel Analytics; change it and the numbers won't line up.
ADMIN_TZ=UTC
# Vercel Analytics numbers in the dashboard (visitors, page views, countries), so they match Vercel exactly.
# Token: vercel.com/account/settings/tokens (scope: your team). IDs: .vercel/project.json after `vercel link`.
VERCEL_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=prj_...
VERCEL_ANALYTICS_TEAM_ID=team_...
# Days of history your Vercel plan keeps (31 on Hobby)
# VERCEL_ANALYTICS_DAYS=31
