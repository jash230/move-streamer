# Free key from https://www.themoviedb.org/settings/api (v3 API key or v4 read access token)
VITE_TMDB_API_KEY=your_tmdb_v3_api_key
# VidSrc embed domain (backup server; these rotate, swap if one goes down)
VITE_VIDSRC_BASE=https://vidsrc.sh

# --- Admin dashboard (/yardenos) ---
# Clerk (dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated Clerk user IDs allowed into /yardenos (the dashboard shows yours if it's missing)
ADMIN_USER_IDS=user_...
# Neon Postgres connection string
DATABASE_URL=postgres://...
# Any long random string; used to authorize /api/cron
CRON_SECRET=
# Day boundary for "today" and daily charts (default: UTC)
ADMIN_TZ=UTC
# Optional Upstash Redis: rate limiting and migration of any previously stored reviews
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Viewer accounts (Supabase) ---
# supabase.com → your project → Project Settings → API. The anon/publishable key is safe in the browser;
# row-level security keeps each viewer to their own rows. Leave unset to keep everything in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only, never VITE_: lets the /yardenos dashboard count sign-ups (Supabase → Project Settings → API Keys → Secret key; the legacy service_role key works too).
SUPABASE_SECRET_KEY=
