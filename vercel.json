{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/movies",
      "destination": "/movies.html"
    },
    {
      "source": "/tv",
      "destination": "/tv.html"
    },
    {
      "source": "/(search|my-list)",
      "destination": "/index.html"
    },
    {
      "source": "/:type(movie|tv)/:id(\\d+)",
      "destination": "/api/title?type=:type&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/yardenos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/api/docs?format=html"
    }
  ],
  "headers": [
    {
      "source": "/search",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/yardenos/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
